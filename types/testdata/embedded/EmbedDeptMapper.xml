<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="EmbedDeptMapper">
	<select id="selectEmbedDeptById" parameterType="Long" resultType="map">
		select * from embed_dept where dept_id = #{deptId}
	</select>
</mapper>
